ANTHROPIC_API_KEY=
FINOPS_STRONG_MODEL=claude-sonnet-4-6
FINOPS_CHEAP_MODEL=claude-haiku-4-5-20251001
DATABASE_URL=postgresql+psycopg://finops:finops@postgres:5432/finops
ENTERPRISE_BASE_URL=http://enterprise:8080
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
AI_PLATFORM_SPLIT=0
FAULT_INJECT=
TRACES_ENABLED=1
# comma-separated allowed browser origins for the portal; "*" for the public demo.
CORS_ALLOW_ORIGINS=*
# hosted deploy: see docs/deploy-railway.md. Managed Postgres URLs (postgresql://…)
# are accepted — the app names the psycopg driver itself. $PORT is honoured when set.
