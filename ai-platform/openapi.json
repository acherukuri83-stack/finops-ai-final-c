    },
    "/diagnose": {
      "post": {
        "summary": "Post Diagnose",
        "description": "Developer Agent \u2014 incident mode. Diagnose a platform fault (failing job / degraded\nservice): find the causing change, the blast radius, and revert-vs-fix-forward, and\npropose a change ticket + rerun for a human to approve.",
        "operationId": "post_diagnose_diagnose_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnoseRequest"
