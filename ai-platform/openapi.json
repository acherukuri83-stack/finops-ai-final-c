              "type": "string"
            },
            "type": "array",
            "title": "Open Questions"
          },
          "checked": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checked"
          },
          "degraded_tools": {
            "items": {
              "type": "string"
