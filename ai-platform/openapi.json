    "/investigate": {
      "post": {
        "summary": "Post Investigate",
        "description": "Investigate a trade (Settlement specialist) or a whole client (Supervisor fan-out).\n\n`{\"trade_id\": ...}` runs the single-trade path; `{\"client_id\": ...}` decomposes across\nspecialists, correlates, and returns one client-level Finding with `sub_findings`.",
        "operationId": "post_investigate_investigate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvestigateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
