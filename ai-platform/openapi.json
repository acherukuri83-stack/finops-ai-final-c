          },
          "request": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request"
          }
        },
        "type": "object",
        "required": [
          "subject_id"
        ],
        "title": "DiagnoseRequest"
      },
      "Event": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "default": ""
          },
          "topic": {
            "type": "string",
            "title": "Topic",
            "default": "settlement.events"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "subject_type": {
            "type": "string",
            "title": "Subject Type",
            "default": "trade"
          },
          "subject_id": {
            "type": "string",
            "title": "Subject Id"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          }
        },
        "type": "object",
        "required": [
          "type",
          "subject_id"
        ],
        "title": "Event",
        "description": "A thing that happened in the estate. `id` is set by the bus on publish."
      },
      "EvidenceLink": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "span_id": {
            "type": "string",
            "title": "Span Id"
          }
        },
        "type": "object",
        "required": [
          "ref",
          "span_id"
        ],
        "title": "EvidenceLink"
      },
      "EvidenceRef": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "cited": {
            "type": "boolean",
            "title": "Cited",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "title": "EvidenceRef"
      },
      "Finding": {
        "properties": {
          "subject": {
            "$ref": "#/components/schemas/SubjectRef"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "root_cause": {
