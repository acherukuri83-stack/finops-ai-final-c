                }
              }
            }
          }
        }
      }
    },
    "/verify": {
      "post": {
        "summary": "Post Verify",
        "description": "Developer Agent \u2014 verification mode. Apply a change ticket, re-check the signals\nthe diagnosis used, hand residual trades to Settlement, and write an incident on a\nclean fix. On failure it reports \u2014 it never proposes a second fix.",
        "operationId": "post_verify_verify_post",
        "requestBody": {
          "content": {
